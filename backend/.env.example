SUPABASE_URL="YOUR_SUPABASE_URL"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# A 32-byte hex string used to encrypt/decrypt user BYOK API keys
# You can generate one via terminal: python -c "import secrets; print(secrets.token_hex(32))"
MASTER_ENCRYPTION_KEY="YOUR_GENERATED_MASTER_KEY"

# Comma-separated frontend origins allowed to call this backend (CORS).
# Defaults to the local Next.js dev server when unset.
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# "production" hides internal error details from API responses; anything else shows them.
APP_ENV="development"
